# 图墙站点 · 子域名模式（SITE_MODE=subdomain）：__SCHEME__://gallery.__BASE__。只给图墙成员（GALLERY_MEMBERS）。
# 防护与 path 模式相同：只认 IP 白名单（app/portal.py），无登录。
server {
  __LISTEN__
  server_name gallery.__BASE__;
  __SSL__
  server_tokens off;
  client_max_body_size 12m;  # 参考图单张 10 MB
  root /home/ubuntu/ai-wedding/wedding-agent/gallery/dist;
  include /etc/nginx/snippets/wedding-portal-gallery.conf;
  include /etc/nginx/snippets/wedding-portal-ip-check.conf;
  include /etc/nginx/snippets/wedding-api-errors.conf;

  location ^~ /.well-known/acme-challenge/ { auth_request off; root /var/www/certbot; }
  location = /robots.txt { default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
  location ^~ /api/ { error_page 401 = @api_401; error_page 403 = @api_403; limit_req zone=gallery_api burst=60 nodelay; proxy_buffering off; proxy_pass http://127.0.0.1:8000/api/gallery/; }

  location / {
    expires -1;
    try_files $uri /index.html;
    location /assets/ { expires 1y; try_files $uri =404; }
  }
}
