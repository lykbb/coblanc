# 图墙站点：__SCHEME__://gallery.__BASE__（BASE 由 deploy.sh 设置：现在 43.142.59.166.nip.io，以后换真实域名）。
# 只给图墙成员（GALLERY_MEMBERS）：nginx 访问密码（/etc/nginx/.htpasswd-gallery）+ 站点凭证（app/portal.py）。只暴露 /api/gallery。
limit_req_zone $binary_remote_addr zone=gallery_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=gallery_login:10m rate=6r/m;

server {
  __LISTEN__
  server_name gallery.__BASE__;
  __SSL__
  auth_basic "gallery";
  auth_basic_user_file /etc/nginx/.htpasswd-gallery;
  client_max_body_size 12m;  # 参考图单张 10 MB
  root /home/ubuntu/ai-wedding/wedding-agent/gallery/dist;
  include /etc/nginx/snippets/wedding-portal.conf;

  location = /api/gallery/redeem { limit_req zone=gallery_login burst=3 nodelay; proxy_pass http://127.0.0.1:8000; }
  location /api/gallery/ { limit_req zone=gallery_api burst=60 nodelay; proxy_pass http://127.0.0.1:8000; proxy_buffering off; }

}
