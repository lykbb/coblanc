# 图墙站点 · 子域名模式（SITE_MODE=subdomain）：__SCHEME__://gallery.__BASE__。只给图墙成员（GALLERY_MEMBERS）。
# 防护与 path 模式相同：nginx 访问密码（/etc/nginx/.htpasswd-gallery）+ IP 白名单 + 站点凭证（app/portal.py）。
server {
  __LISTEN__
  server_name gallery.__BASE__;
  __SSL__
  server_tokens off;
  auth_basic "gallery";
  auth_basic_user_file /etc/nginx/.htpasswd-gallery;
  client_max_body_size 12m;  # 参考图单张 10 MB
  root /home/ubuntu/ai-wedding/wedding-agent/gallery/dist;
  include /etc/nginx/snippets/wedding-portal-gallery.conf;
  include /etc/nginx/snippets/wedding-portal-ip-check.conf;

  location ^~ /.well-known/acme-challenge/ { auth_request off; auth_basic off; root /var/www/certbot; }
  location = /robots.txt { default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
  location = /api/redeem { limit_req zone=gallery_login burst=3 nodelay; proxy_pass http://127.0.0.1:8000/api/gallery/redeem; }
  location ^~ /api/ { limit_req zone=gallery_api burst=60 nodelay; proxy_buffering off; proxy_pass http://127.0.0.1:8000/api/gallery/; }

  location / {
    expires -1;
    try_files $uri /index.html;
    location /assets/ { expires 1y; try_files $uri =404; }
  }
}
