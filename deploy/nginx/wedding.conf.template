# 前台（/etc/nginx/sites-available/wedding）：默认站点，现在用裸 IP 访问，以后是主域名（BASE）。
# 图墙、后台：path 模式（默认）挂在本 server 的 /gallery/、/abordadmin/；subdomain 模式分到 wedding-gallery / wedding-admin。
# 与原配置一致，另加：屏蔽内部接口、隐藏版本号。前台页面不链接内部站点。
__HTTPS_REDIRECT__
server {
  __LISTEN_DEFAULT__
  server_name _;
  __SSL__
  server_tokens off;
  # 前台账号密码登录页（app/login.py，账号密码沿用 /etc/nginx/.htpasswd）：没有登录会话的请求一律跳 /login
  auth_request /_gate_front;
  error_page 401 = @front_login;
  client_max_body_size 50m;
  root /home/ubuntu/ai-wedding/wedding-agent/web/dist;
  # 内部站点的接口只从各自站点访问
  location ^~ /api/admin/ { return 404; }
  location ^~ /api/gallery/ { return 404; }
  location ^~ /.well-known/acme-challenge/ { auth_request off; root /var/www/certbot; }  # certbot 验证
  location = /_gate_front {
    internal;
    proxy_pass http://127.0.0.1:8000/internal/gate/front;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-IP $remote_addr;
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Host $host;
  }
  location @front_login { return 302 /login?next=$uri; }
  location = /login { auth_request off; limit_req zone=front_login burst=6 nodelay; limit_req_status 429; include /etc/nginx/snippets/wedding-login-proxy.conf; proxy_pass http://127.0.0.1:8000/auth/front/login; }
  location = /logout { auth_request off; include /etc/nginx/snippets/wedding-login-proxy.conf; proxy_pass http://127.0.0.1:8000/auth/front/logout; }
  location = /robots.txt { auth_request off; default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
__PORTALS__  location = /coblanc-film { return 301 /coblanc-film/; }
  location /coblanc-film/ { try_files $uri $uri/ /coblanc-film/index.html; }
  location ~ ^/(api|files|templates|docs|openapi.json|redoc)(/|$) {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 600s; proxy_send_timeout 600s; proxy_buffering off;
  }
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
  location ~* \.(webp|jpg|jpeg|png|svg|woff2?)$ { expires 30d; add_header Cache-Control "public"; try_files $uri =404; }
  location = /index.html { add_header Cache-Control "no-cache"; }
  location / { add_header Cache-Control "no-cache"; try_files $uri $uri/ /index.html; }
}
