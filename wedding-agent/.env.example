# 复制成 .env 再填写。.env 不提交到仓库。

# 运行模式：1 = 所有模块用示例数据，不调用任何付费服务；0 = 全部走真实实现
FAKE=1
# FAKE=1 时，单独切到真实实现的模块，逗号分隔，例如 styling,generation
REAL_MODULES=
# 演示修图流程：第一次质检故意判为不合格
FAKE_FAIL_FIRST_CHECK=0

# 服务
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173
# 图片存放目录，留空则用项目里的 storage/
STORAGE_DIR=
RETENTION_DAYS=7

# 流程上限
MAX_QUESTION_ROUNDS=2
MAX_RETOUCH=2
MAX_USER_REDO=2
CANDIDATES_PER_ROUND=4
MAX_IMAGES_PER_TASK=16
IMAGE_TIMEOUT_SECONDS=120
# 人脸相似度及格线，需按实测结果调整
FACE_SIM_THRESHOLD=0.5

# 大模型（火山方舟，兼容 OpenAI 接口）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL_AGENT=
LLM_MODEL_CHEAP=
LLM_MODEL_VISION=
LLM_TIMEOUT_SECONDS=60

# 生图服务
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=
SEEDREAM_MODEL=
