# 复制成 .env 再填写。.env 不提交到仓库。

# 运行模式：1 = 所有模块用示例数据，不调用任何付费服务；0 = 全部走真实实现
FAKE=1
# FAKE=1 时，单独切到真实实现的模块，逗号分隔，例如 styling,generation
REAL_MODULES=
# 演示修图流程：第一次质检故意判为不合格
FAKE_FAIL_FIRST_CHECK=0
# 演示用：fake 模式下每个模块停几秒，让网页上的进度动画看得见
FAKE_DELAY_SECONDS=0

# 服务
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173
# 图片存放目录，留空则用项目里的 storage/
STORAGE_DIR=
RETENTION_DAYS=7

# 流程上限
MAX_QUESTION_ROUNDS=2
MAX_RETOUCH=2
MAX_USER_REDO=2
# agent（小囍、妆造师、摄影师、生图、修图师）每次最多调用几次工具
MAX_AGENT_STEPS=6
# 生图时除了用户照片，最多再带几张参考图（姿势、婚纱、背景）
MAX_REFERENCE_IMAGES=2
# 先出 1 张样片，用户确认后再出 9 张套图
SAMPLE_CANDIDATES=1
SET_CANDIDATES=9
# 每个任务最多生成几张（含修图和重做）：1 张样片 + 9 张套图，再留约 2 轮套图重做的余量
MAX_IMAGES_PER_TASK=30
IMAGE_TIMEOUT_SECONDS=120
# 人脸相似度及格线，需按实测结果调整
FACE_SIM_THRESHOLD=0.5

# 大模型（火山方舟，兼容 OpenAI 接口）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL_AGENT=
LLM_MODEL_CHEAP=
LLM_MODEL_VISION=
LLM_TIMEOUT_SECONDS=60

# 生图服务
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=
SEEDREAM_MODEL=
